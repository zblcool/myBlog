# Ashmartisan site wiring (src/studio/config.ts). Copy to .env locally (not committed);
# in CI set them as repository variables. Everything is optional.

# Live Interactive Equipment Explainer. Unset = its Vercel deployment (src/studio/config.ts).
PUBLIC_DEMO_URL=https://YOUR-EXPLAINER-DEPLOYMENT
# Form service that receives enquiries (Formspree, Web3Forms, Getform... any JSON POST).
# Unset = the Formspree form in src/studio/config.ts.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
# Only for services that want a key in the body (Web3Forms access_key).
PUBLIC_FORM_ACCESS_KEY=
# Plausible-compatible, cookieless analytics. Unset = no script.
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_HOST=https://plausible.io
