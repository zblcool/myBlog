---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { toolLinks } from "@/data/site";

const tool = toolLinks[0];
---

<BaseLayout title="Tools | Ash Zhang" description={tool.summary} cta={false}>
  <div class="wrap">
    <header class="page-head">
      <span class="label">Tool</span>
      <h1>{tool.title}</h1>
      <p>{tool.summary}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={tool.href} target="_blank" rel="noreferrer">Open in new tab</a>
      </div>
    </header>
    <div class="embed-shell page-body">
      <iframe src={tool.href} title={tool.title}></iframe>
    </div>
  </div>
</BaseLayout>
