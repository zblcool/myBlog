---
import { getCollection } from "astro:content";
import ContentCard from "@/components/ContentCard.astro";
import WritingTabs from "@/components/WritingTabs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  collectTagCounts,
  slugifyTag,
  sortEntriesByDateDesc,
} from "@/lib/content";
import { withBase } from "@/lib/paths";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const notes = await getCollection("notes");
  const allEntries = [...posts, ...notes];
  const seen = new Set<string>();

  return allEntries.flatMap((entry) =>
    entry.data.tags.flatMap((tag) => {
      const slug = slugifyTag(tag);

      if (seen.has(slug)) {
        return [];
      }

      seen.add(slug);
      return {
        params: { tag: slug },
        props: { tag },
      };
    }),
  );
}

const { tag } = Astro.props;
const posts = await getCollection("posts");
const notes = await getCollection("notes");

const relatedPosts = sortEntriesByDateDesc(
  posts.filter((entry) => entry.data.tags.includes(tag)),
);
const relatedNotes = sortEntriesByDateDesc(
  notes.filter((entry) => entry.data.tags.includes(tag)),
);
const relatedEntries = [...relatedPosts, ...relatedNotes];
---

<BaseLayout title={`${tag} | Ash Zhang`} description={`Entries tagged ${tag}`} cta={false}>
  <div class="wrap">
    <header class="page-head">
      <WritingTabs active="tag" />
      <h1>{tag}</h1>
    </header>
    <div class="page-body">
      {relatedPosts.length > 0 && (
        <section class="archive-group">
          <h2>Writing</h2>
          <div class="entry-list">
            {relatedPosts.map((entry) => <ContentCard entry={entry} kind="post" />)}
          </div>
        </section>
      )}
      {relatedNotes.length > 0 && (
        <section class="archive-group">
          <h2>Notes</h2>
          <div class="entry-list">
            {relatedNotes.map((entry) => <ContentCard entry={entry} kind="notes" />)}
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
