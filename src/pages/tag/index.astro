---
import { getCollection } from "astro:content";
import WritingTabs from "@/components/WritingTabs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { collectTagSummaries } from "@/lib/content";
import { withBase } from "@/lib/paths";

const tags = collectTagSummaries(await getCollection("posts"), await getCollection("notes"));
---

<BaseLayout title="Topics | Ash Zhang" description="Browse writing by topic." cta={false}>
  <div class="wrap">
    <header class="page-head">
      <WritingTabs active="tag" />
      <h1>Topics</h1>
      <p>Browse posts and notes by subject.</p>
    </header>
    <div class="tag-cloud page-body">
      {tags.map((item) => (
        <a class="tag" href={withBase(`/tag/${item.slug}/`)}>{item.tag}<span>{item.count}</span></a>
      ))}
    </div>
  </div>
</BaseLayout>
