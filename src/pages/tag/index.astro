---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageMasthead from "@/components/PageMasthead.astro";
import { collectTagSummaries } from "@/lib/content";
import { withBase } from "@/lib/paths";

const posts = await getCollection("posts");
const notes = await getCollection("notes");
const tags = collectTagSummaries(posts, notes);
---

<BaseLayout title="Tags | Ash Zhang" description="Tag archive">
  <PageMasthead
    eyebrow="Tags"
    title="Tag archive"
    lead="Tags stay attached to the source Markdown and are indexed separately in the new site layer."
    detail="This page is the subject-first view of the site: useful when visitors care more about themes like graphics, JavaScript, or algorithms than about whether something is a post or a note."
  >
    <a slot="actions" class="button button--primary" href={withBase("/post/")}>Browse posts</a>
    <a slot="actions" class="button" href={withBase("/")}>Back home</a>

    <article slot="facts" class="page-fact-card">
      <span>Unique tags</span>
      <strong>{tags.length}</strong>
      <p>Topic buckets generated from the current writing archive.</p>
    </article>
    <article slot="facts" class="page-fact-card">
      <span>Tagged posts</span>
      <strong>{posts.length}</strong>
      <p>Polished articles currently participating in tag browsing.</p>
    </article>
    <article slot="facts" class="page-fact-card">
      <span>Tagged notes</span>
      <strong>{notes.length}</strong>
      <p>Rougher study material indexed with the same metadata system.</p>
    </article>
  </PageMasthead>

  <section class="section">
    <div class="card-grid">
      {
        tags.map((item) => (
          <article class="tag-card">
            <h3>
              <a href={withBase(`/tag/${item.slug}/`)}>{item.tag}</a>
            </h3>
            <p class="muted">{item.count} linked entries</p>
            <div class="tag-card__split">
              <span>{item.postCount} posts</span>
              <span>{item.noteCount} notes</span>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
