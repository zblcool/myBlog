---
import WorkCard from "@/components/WorkCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
---

<BaseLayout title="Work | Ash Zhang" description="Selected interactive, game and design projects by Ash Zhang.">
  <div class="wrap">
    <header class="page-head">
      <span class="label">Work</span>
      <h1>Selected projects</h1>
    </header>
    <div class="work-grid page-body">
      {projects.map((project, i) => <WorkCard project={project} lead={i === 0} />)}
    </div>
  </div>
</BaseLayout>
