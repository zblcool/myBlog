---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
import { isExternalPath, withBase } from "@/lib/paths";

export async function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const gallery = project.gallery
  .map((item) => (typeof item === "string" ? { src: item } : item))
  .filter((item) => project.banner || item.src !== project.cover);
---

<BaseLayout title={`${project.title} | Ash Zhang`} description={project.headline}>
  <article class="wrap">
    <header class="page-head">
      <span class="label">{project.kind} · {project.year}</span>
      <h1>{project.title}</h1>
      <p>{project.headline}</p>
      {project.links.length > 0 && (
        <div class="hero__actions">
          {project.links.map((link, i) => (
            <a
              class:list={["btn", i === 0 && "btn--solid"]}
              href={isExternalPath(link.href) ? link.href : withBase(link.href)}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}>{link.label}</a
            >
          ))}
        </div>
      )}
    </header>

    <div class="case-meta">
      <div><span class="label">Role</span><strong>{project.role}</strong></div>
      <div><span class="label">Year</span><strong>{project.year}</strong></div>
      <div><span class="label">Stack</span><strong>{project.stack.join(", ")}</strong></div>
    </div>

    {project.banner ? (
      <img class="case-banner" src={withBase(project.banner)} alt={project.title} />
    ) : (
      <img class="case-cover" src={withBase(project.cover)} alt={project.title} />
    )}

    <div class="case-story">
      <section><h2>Challenge</h2><p>{project.challenge}</p></section>
      <section><h2>Approach</h2><p>{project.approach}</p></section>
      <section><h2>Outcome</h2><p>{project.outcome}</p></section>
    </div>

    {project.demo && (
      <section class="case-demo">
        <div class="case-demo__head">
          <h2>Live demo</h2>
          <a class="link-arrow" href={project.demo.src} target="_blank" rel="noreferrer">Open full screen ↗</a>
        </div>
        <div class="case-demo__frame" data-demo-src={project.demo.src}>
          <img src={withBase(project.demo.poster)} alt="" loading="lazy" />
          <button class="btn btn--solid" type="button">Start the demo</button>
        </div>
        {project.demo.note && <p class="case-demo__note">{project.demo.note}</p>}
      </section>
    )}

    {gallery.length > 0 && (
      <div class="case-gallery">
        {gallery.map((item) => (
          <figure class:list={[item.size && `case-gallery--${item.size}`]}>
            <img src={withBase(item.src)} alt={item.caption ?? project.title} loading="lazy" />
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <a class="case-next page-body" href={withBase(`/blog/portfolio/${next.slug}/`)}>
      <span class="label">Next project</span>
      <strong>{next.title} →</strong>
    </a>
  </article>
</BaseLayout>

<script>
  // The demo is a full 3D scene with sound: load it only once the visitor asks for it.
  document.querySelectorAll<HTMLElement>("[data-demo-src]").forEach((frame) => {
    frame.querySelector("button")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = frame.dataset.demoSrc!;
      iframe.title = "Live demo";
      iframe.allow = "autoplay; fullscreen";
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);

      // Wheel zoom inside the demo would otherwise also scroll the page, and a
      // cross-origin frame can't be stopped from here: freeze the page instead
      // while the pointer is over it.
      const root = document.documentElement;
      const lock = () => {
        root.style.paddingRight = `${window.innerWidth - root.clientWidth}px`;
        root.style.overflow = "hidden";
      };
      frame.addEventListener("pointerenter", lock);
      frame.addEventListener("pointerleave", () => {
        root.style.overflow = "";
        root.style.paddingRight = "";
      });
      lock();
    });
  });
</script>
