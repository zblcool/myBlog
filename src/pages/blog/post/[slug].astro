---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  formatDate,
  getAdjacentEntries,
  getEntryCover,
  getEntryCoverAlt,
  getEntrySummary,
  getEntryUrl,
  getTagUrl,
  sortEntriesByDateDesc,
} from "@/lib/content";
import { withBase } from "@/lib/paths";
import { articleStructuredData } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const posts = sortEntriesByDateDesc(await getCollection("posts"));
const { newer, older } = getAdjacentEntries(posts, entry.id);
const cover = getEntryCover(entry);
const intro = entry.data.description ?? entry.data.summary;
const description = entry.data.description ?? getEntrySummary(entry, 155);
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path);
// Relative image paths in old notes cannot be resolved for link previews, so only root and absolute ones are shared.
const shareImage = cover && (cover.startsWith("/") || cover.startsWith("http")) ? cover : undefined;
const structuredData = articleStructuredData(
  entry,
  { name: "Posts", url: absolute(withBase("/blog/post/")) },
  absolute(withBase(getEntryUrl("post", entry))),
  absolute(withBase("/")),
  description,
  shareImage && absolute(shareImage),
);
---

<BaseLayout
  cta={false}
  title={`${entry.data.title} | Ash Zhang`}
  description={description}
  image={shareImage}
  publishedTime={entry.data.date}
  structuredData={structuredData}
>
  <article class="article-shell">
    <div class="label">Post</div>
    <h1>{entry.data.title}</h1>
    <div class="article-meta label">
      <span>{formatDate(entry.data.date)}</span>
      {entry.data.location && (
        <>
          <span> · </span>
          <span>{entry.data.location}</span>
        </>
      )}
      {entry.data.author && (
        <>
          <span> · </span>
          <span>{entry.data.author}</span>
        </>
      )}
    </div>

    {intro && <p class="article-intro">{intro}</p>}

    {cover && (
      <img class="article-cover" src={cover} alt={getEntryCoverAlt(entry)} loading="lazy" />
    )}

    {entry.data.tags.length > 0 && (
      <div class="tag-list">
        {entry.data.tags.map((tag) => (
          <a class="tag-link" href={withBase(getTagUrl(tag))}>
            {tag}
          </a>
        ))}
      </div>
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>

  <div class="pager wrap">
    {older ? (
      <a href={withBase(getEntryUrl("post", older))}><span class="label">Older</span><strong>{older.data.title}</strong></a>
    ) : <span />}
    {newer && (
      <a href={withBase(getEntryUrl("post", newer))}><span class="label">Newer</span><strong>{newer.data.title}</strong></a>
    )}
  </div>
</BaseLayout>
