---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  formatDate,
  getAdjacentEntries,
  getEntryCover,
  getEntryCoverAlt,
  getEntryUrl,
  getTagUrl,
  sortEntriesByDateDesc,
} from "@/lib/content";
import { withBase } from "@/lib/paths";

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const notes = sortEntriesByDateDesc(await getCollection("notes"));
const { newer, older } = getAdjacentEntries(notes, entry.id);
const cover = getEntryCover(entry);
const intro = entry.data.description ?? entry.data.summary;
---

<BaseLayout
  cta={false}
  title={`${entry.data.title} | Ash Zhang`}
  description={entry.data.description ?? entry.data.title}
>
  <article class="article-shell">
    <div class="label">Note</div>
    <h1>{entry.data.title}</h1>
    <div class="article-meta label">
      <span>{formatDate(entry.data.date)}</span>
      {entry.data.location && (
        <>
          <span> · </span>
          <span>{entry.data.location}</span>
        </>
      )}
      {entry.data.author && (
        <>
          <span> · </span>
          <span>{entry.data.author}</span>
        </>
      )}
    </div>

    {intro && <p class="article-intro">{intro}</p>}

    {cover && (
      <img class="article-cover" src={cover} alt={getEntryCoverAlt(entry)} loading="lazy" />
    )}

    {entry.data.tags.length > 0 && (
      <div class="tag-list">
        {entry.data.tags.map((tag) => (
          <a class="tag-link" href={withBase(getTagUrl(tag))}>
            {tag}
          </a>
        ))}
      </div>
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>

  <div class="pager wrap">
    {older ? (
      <a href={withBase(getEntryUrl("notes", older))}><span class="label">Older</span><strong>{older.data.title}</strong></a>
    ) : <span />}
    {newer && (
      <a href={withBase(getEntryUrl("notes", newer))}><span class="label">Newer</span><strong>{newer.data.title}</strong></a>
    )}
  </div>
</BaseLayout>
