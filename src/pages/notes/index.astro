---
import { getCollection } from "astro:content";
import ArchiveList from "@/components/ArchiveList.astro";
import WritingTabs from "@/components/WritingTabs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { groupEntriesByYear, sortEntriesByDateDesc } from "@/lib/content";

const groups = groupEntriesByYear(sortEntriesByDateDesc(await getCollection("notes")));
---

<BaseLayout title="Notes | Ash Zhang" description="Working notes and study material." cta={false}>
  <div class="wrap">
    <header class="page-head">
      <WritingTabs active="notes" />
      <h1>Notes</h1>
      <p>Working notes and study material.</p>
    </header>
    <div class="page-body">
      <ArchiveList groups={groups} kind="notes" />
    </div>
  </div>
</BaseLayout>
