---
import { getCollection } from "astro:content";
import ArchiveYearGroup from "@/components/ArchiveYearGroup.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  collectTagCounts,
  groupEntriesByYear,
  sortEntriesByDateDesc,
} from "@/lib/content";
import { withBase } from "@/lib/paths";

const notes = sortEntriesByDateDesc(await getCollection("notes"));
const archiveGroups = groupEntriesByYear(notes);
const topTags = collectTagCounts(notes).slice(0, 6);
const yearSpan =
  archiveGroups.length > 0
    ? `${archiveGroups[archiveGroups.length - 1]?.year} - ${archiveGroups[0]?.year}`
    : "Archive";
---

<BaseLayout title="Notes | Ash Zhang" description="Migrated note archive">
  <section class="panel panel--padded">
    <div class="eyebrow">Notes</div>
    <h1 class="page-title">Learning notebook</h1>
    <p class="lead">
      Notes are still authored in Markdown, but now rendered through a newer,
      more flexible site shell.
    </p>

    <div class="stats-grid">
      <article class="stat-card">
        <span class="eyebrow">Total notes</span>
        <strong>{notes.length}</strong>
      </article>
      <article class="stat-card">
        <span class="eyebrow">Year span</span>
        <strong>{yearSpan}</strong>
      </article>
      <article class="stat-card">
        <span class="eyebrow">Top tags</span>
        <div class="tag-list">
          {topTags.map((tag) => (
            <a class="tag-link" href={withBase(`/tag/${tag.slug}/`)}>
              {tag.tag}
            </a>
          ))}
        </div>
      </article>
    </div>
  </section>

  <div class="section-head">
    <a class="button" href={withBase("/")}>Back home</a>
  </div>

  {archiveGroups.map((group) => <ArchiveYearGroup group={group} kind="notes" />)}
</BaseLayout>
