---
import { getCollection } from "astro:content";
import ArchiveList from "@/components/ArchiveList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { groupEntriesByYear, sortEntriesByDateDesc } from "@/lib/content";
import { withBase } from "@/lib/paths";

const groups = groupEntriesByYear(sortEntriesByDateDesc(await getCollection("notes")));
---

<BaseLayout title="Notes | Ash Zhang" description="Working notes and study material." cta={false}>
  <div class="wrap">
    <header class="page-head">
      <span class="label">Notes</span>
      <h1>Notes</h1>
      <p>
        Working notes and study material.
        <a class="link-arrow" href={withBase("/tag/")}>Browse by tag</a>
      </p>
    </header>
    <div class="page-body">
      <ArchiveList groups={groups} kind="notes" />
    </div>
  </div>
</BaseLayout>
