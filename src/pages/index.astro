---
import { getCollection } from "astro:content";
import ContentCard from "@/components/ContentCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectSpotlight from "@/components/ProjectSpotlight.astro";
import HeroScene from "@/components/react/three/HeroScene";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
import { migrationPrinciples, profile, siteSections } from "@/data/site";
import { sortEntriesByDateDesc } from "@/lib/content";
import { withBase } from "@/lib/paths";

const posts = sortEntriesByDateDesc(await getCollection("posts"));
const notes = sortEntriesByDateDesc(await getCollection("notes"));
const latestPosts = posts.slice(0, 3);
const latestNotes = notes.slice(0, 3);
const spotlightProject = projects[0];
const featuredProjects = projects.slice(1, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">Ash Zhang</div>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.tagline}</p>
      <p class="lead">{profile.intro}</p>

      <div class="hero-actions">
        <a class="button button--primary" href={withBase("/portfolio/")}>See selected work</a>
        <a class="button" href={withBase("/post/")}>Browse writing</a>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <strong>{posts.length + notes.length}</strong>
          <span>Markdown entries already flowing through the new content layer</span>
        </div>
        <div class="stat-card">
          <strong>Data-first</strong>
          <span>Projects and site metadata now live outside page templates</span>
        </div>
        <div class="stat-card">
          <strong>3D-ready</strong>
          <span>Interactive work can grow in isolated React and Three.js islands</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <HeroScene client:load />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Explore the site</h2>
        <p>
          The rebuild now separates writing, learning notes, work, profile, and
          tools more clearly so each section has a stronger role.
        </p>
      </div>
    </div>

    <div class="section-directory-grid">
      {siteSections.map((section) => (
        <article class="section-directory-card">
          <span class="section-directory-card__eyebrow">{section.eyebrow}</span>
          <h3>
            <a href={withBase(section.href)}>{section.title}</a>
          </h3>
          <p>{section.summary}</p>
          <span class="section-directory-card__detail">{section.detail}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Current spotlight</h2>
        <p>
          The rebuild should lead with the work that best represents the next
          version of the site. Right now that is Hanzi Workshop: a bilingual game
          prototype with real interface depth, a clearer visual direction, and a
          genuine in-run capture.
        </p>
      </div>
      <a class="button" href={withBase("/portfolio/")}>Open all case studies</a>
    </div>

    <ProjectSpotlight
      project={spotlightProject}
      eyebrow="Featured Project"
      title="Hanzi Workshop deserves to lead the portfolio"
      summary="This is the strongest bridge between your current site direction and your future Three.js-friendly work: it is interactive, design-heavy, technically layered, and already has enough material to present like a proper case study."
    />
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Selected work</h2>
        <p>
          The rest of the portfolio still matters, but it now sits behind a
          clearer lead project instead of competing for attention on equal footing.
        </p>
      </div>
      <a class="button" href={withBase("/portfolio/")}>More case studies</a>
    </div>

    <div class="card-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Rebuild rules</h2>
        <p>
          These are the constraints we are keeping during migration so future
          framework changes stay realistic instead of painful.
        </p>
      </div>
    </div>

    <div class="principle-grid">
      {migrationPrinciples.map((item, index) => (
        <article class="principle-card">
          <span class="principle-card__index">0{index + 1}</span>
          <p>{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Latest posts</h2>
        <p>Writing that is already coming from the existing Markdown archive.</p>
      </div>
      <a class="button" href={withBase("/post/")}>All posts</a>
    </div>

    <div class="card-grid">
      {latestPosts.map((entry) => <ContentCard entry={entry} kind="post" />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Latest notes</h2>
        <p>
          Notes stay editable as content files, while presentation moves into the
          new site layer.
        </p>
      </div>
      <a class="button" href={withBase("/notes/")}>All notes</a>
    </div>

    <div class="card-grid">
      {latestNotes.map((entry) => <ContentCard entry={entry} kind="notes" />)}
    </div>
  </section>
</BaseLayout>
