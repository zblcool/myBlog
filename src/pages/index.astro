---
import { getCollection } from "astro:content";
import ContentCard from "@/components/ContentCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectSpotlight from "@/components/ProjectSpotlight.astro";
import HeroScene from "@/components/react/three/HeroScene";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
import { profile, siteSections } from "@/data/site";
import { sortEntriesByDateDesc } from "@/lib/content";
import { withBase } from "@/lib/paths";

const posts = sortEntriesByDateDesc(await getCollection("posts"));
const notes = sortEntriesByDateDesc(await getCollection("notes"));
const latestPosts = posts.slice(0, 2);
const latestNotes = notes.slice(0, 2);
const spotlightProject = projects[0];
const featuredProjects = projects.slice(1, 4);
const quickPaths = [
  {
    eyebrow: "Work",
    title: "Portfolio",
    href: "/portfolio/",
    metric: `${projects.length} case studies`,
    detail: "Interactive projects first",
  },
  {
    eyebrow: "Writing",
    title: "Posts",
    href: "/post/",
    metric: `${posts.length} published posts`,
    detail: "Polished articles",
  },
  {
    eyebrow: "Learning",
    title: "Notes",
    href: "/notes/",
    metric: `${notes.length} active notes`,
    detail: "Rough but useful",
  },
  {
    eyebrow: "Profile",
    title: "CV",
    href: "/cv/",
    metric: "Resume + snapshot",
    detail: "Quick context",
  },
];
const homeHighlights = [
  "Interactive graphics",
  "Technical writing",
  "Playable systems",
];
const showcaseSections = siteSections.filter((section) =>
  ["Portfolio", "Posts", "Notes", "Tools"].includes(section.title),
);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow">Ash Zhang</div>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.tagline}</p>

      <div class="hero-badge-list">
        {homeHighlights.map((item) => (
          <span class="hero-badge">{item}</span>
        ))}
      </div>

      <div class="hero-actions">
        <a class="button button--primary" href={withBase("/portfolio/")}>See selected work</a>
        <a class="button" href={withBase("/post/")}>Browse writing</a>
      </div>

      <div class="hero-metrics">
        <div class="hero-metric-card">
          <strong>{posts.length + notes.length}</strong>
          <span>entries in the live content archive</span>
        </div>
        <div class="hero-metric-card">
          <strong>{spotlightProject.title}</strong>
          <span>current lead case study</span>
        </div>
        <div class="hero-metric-card">
          <strong>{profile.title}</strong>
          <span>graphics work and writing side by side</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <HeroScene client:load />
    </div>
  </section>

  <section class="home-stage">
    <ProjectSpotlight
      project={spotlightProject}
      eyebrow="Featured Project"
      title="Hanzi Workshop / 汉字工坊"
      summary="A bilingual game prototype with enough depth, visual identity, and real in-run material to carry the first impression of the site."
      compact
    />

    <div class="home-stage__side">
      <div class="home-quick-grid">
        {quickPaths.map((item) => (
          <a class="home-quick-card" href={withBase(item.href)}>
            <span class="home-quick-card__eyebrow">{item.eyebrow}</span>
            <strong>{item.title}</strong>
            <span class="home-quick-card__metric">{item.metric}</span>
            <span class="home-quick-card__detail">{item.detail}</span>
          </a>
        ))}
      </div>

      <div class="home-strip">
        {showcaseSections.map((section) => (
          <a class="home-strip__item" href={withBase(section.href)}>
            <span>{section.eyebrow}</span>
            <strong>{section.title}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Selected work</h2>
        <p>More case studies and archive pieces behind the flagship project.</p>
      </div>
      <a class="button" href={withBase("/portfolio/")}>More case studies</a>
    </div>

    <div class="card-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Writing now</h2>
        <p>The newest finished posts and active notes, without making the home page read like an archive index.</p>
      </div>
      <div class="hero-actions">
        <a class="button" href={withBase("/post/")}>All posts</a>
        <a class="button" href={withBase("/notes/")}>All notes</a>
      </div>
    </div>

    <div class="home-writing-grid">
      <div class="home-writing-column">
        <div class="home-writing-column__head">
          <span class="eyebrow">Posts</span>
          <h3>Polished writing</h3>
        </div>
        <div class="card-grid">
          {latestPosts.map((entry) => <ContentCard entry={entry} kind="post" />)}
        </div>
      </div>

      <div class="home-writing-column">
        <div class="home-writing-column__head">
          <span class="eyebrow">Notes</span>
          <h3>Fresh notes</h3>
        </div>
        <div class="card-grid">
          {latestNotes.map((entry) => <ContentCard entry={entry} kind="notes" />)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
