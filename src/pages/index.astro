---
import { getCollection } from "astro:content";
import ContentCard from "@/components/ContentCard.astro";
import WorkCard from "@/components/WorkCard.astro";
import BabylonDemo from "@/components/react/demos/BabylonDemo";
import CesiumDemo from "@/components/react/demos/CesiumDemo";
import ShaderDemo from "@/components/react/demos/ShaderDemo";
import UiDemo from "@/components/react/demos/UiDemo";
import HeroScene from "@/components/react/three/HeroScene";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/data/projects";
import { contactHref, contactLabel, facts, profile, services } from "@/data/site";
import { sortEntriesByDateDesc } from "@/lib/content";
import { withBase } from "@/lib/paths";

const latestPosts = sortEntriesByDateDesc(await getCollection("posts")).slice(0, 4);
const external = contactHref.startsWith("http");
---

<BaseLayout>
  <section class="hero">
    <div class="hero__scene" aria-hidden="true">
      <HeroScene client:load />
    </div>
    <div class="wrap hero__inner">
      <span class="label">{profile.title} · {profile.location}</span>
      <h1>I build real-time <em>3D</em> for the web.</h1>
      <p class="hero__lead">{profile.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--solid" href={withBase("/portfolio/")}>View work</a>
        <a
          class="btn"
          href={contactHref}
          target={external ? "_blank" : undefined}
          rel={external ? "noreferrer" : undefined}>{contactLabel}</a
        >
        <a class="link-arrow hero__demo" href="https://hanzi-survivor.vercel.app/" target="_blank" rel="noreferrer">Play the Hanzi demo ↗</a>
      </div>
      <div class="facts">
        {facts.map((item) => (
          <div>
            <strong>{item.value}</strong>
            <span class="label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected work</h2>
        <a class="link-arrow" href={withBase("/portfolio/")}>All projects</a>
      </div>
      <div class="work-grid">
        {projects.map((project, i) => <WorkCard project={project} lead={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2>What I do</h2>
      </div>
      <div class="services">
        {services.map((item) => (
          <article class="service">
            <div class="service__stage">
              {item.demo === "babylon" && <BabylonDemo client:visible />}
              {item.demo === "shader" && <ShaderDemo client:visible />}
              {item.demo === "cesium" && <CesiumDemo client:visible />}
              {item.demo === "ui" && <UiDemo client:visible />}
              <span class="service__hint">{item.hint}</span>
            </div>
            <div class="service__body">
              <span class="label">{item.index}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <div class="tag-list">
                {item.tools.map((tool) => <span class="tag">{tool}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Writing</h2>
        <a class="link-arrow" href={withBase("/post/")}>All posts</a>
      </div>
      <div class="entry-list">
        {latestPosts.map((entry) => <ContentCard entry={entry} kind="post" />)}
      </div>
    </div>
  </section>
</BaseLayout>
