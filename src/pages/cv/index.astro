---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { about, profile, socialLinks } from "@/data/site";
import { withBase } from "@/lib/paths";

const pdf = withBase("/document/Ash-Zhang-CV.pdf");
---

<BaseLayout title="About | Ash Zhang" description={profile.description}>
  <div class="wrap">
    <header class="page-head">
      <span class="label">About</span>
      <h1>{profile.title}</h1>
      <div class="hero__actions">
        <a class="btn btn--solid" href={pdf}>Download CV</a>
        {socialLinks.map((link) => (
          <a class="btn" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
      </div>
    </header>

    <div class="about-grid page-body">
      <p class="about-summary">{about.summary}</p>
      <div>
        <h2 class="subhead">Strengths</h2>
        <ul class="plain-list">
          {about.strengths.map((item) => <li>{item}</li>)}
        </ul>
        <h2 class="subhead">Tools</h2>
        <div class="tag-list">
          {about.stack.map((item) => <span class="tag">{item}</span>)}
        </div>
      </div>
    </div>

    <section class="page-body about-grid">
      <div>
        <h2 class="subhead">3D & graphics projects</h2>
        <ul class="plain-list">
          {about.research.map((item) => <li><strong>{item.title}</strong><br /><span class="muted">{item.text}</span></li>)}
        </ul>
      </div>
      <div>
        <h2 class="subhead">Education</h2>
        <ul class="plain-list">{about.education.map((item) => <li>{item}</li>)}</ul>
        <h2 class="subhead">Awards</h2>
        <ul class="plain-list">{about.awards.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

  </div>
</BaseLayout>
