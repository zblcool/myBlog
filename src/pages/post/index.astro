---
import { getCollection } from "astro:content";
import ArchiveList from "@/components/ArchiveList.astro";
import WritingTabs from "@/components/WritingTabs.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { groupEntriesByYear, sortEntriesByDateDesc } from "@/lib/content";

const groups = groupEntriesByYear(sortEntriesByDateDesc(await getCollection("posts")));
---

<BaseLayout title="Writing | Ash Zhang" description="Articles on graphics, front-end and software craft." cta={false}>
  <div class="wrap">
    <header class="page-head">
      <WritingTabs active="post" />
      <h1>Posts</h1>
      <p>Articles on graphics, front-end and software craft.</p>
    </header>
    <div class="page-body">
      <ArchiveList groups={groups} kind="post" />
    </div>
  </div>
</BaseLayout>
