---
/**
 * Hero: the brand line, headline and value statement over the live 3D exhibition booth
 * (HeroStage), with the two first actions: open a live demo, or ask for a quote.
 */
import HeroStage from "./HeroStage.astro";
import { demoLink } from "@/studio/config";
import type { Copy } from "@/studio/i18n/en";
import { equipmentIds } from "@/studio/stage/presets";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const demoLinks = Object.fromEntries(equipmentIds.map((id) => [id, demoLink(id, { lang: t.lang })]));
// The booth's tablet runs the real explainer in embed mode when a visitor opens it; they have
// already asked for it, so it skips the explainer's click-to-load cover.
const tabletApp = demoLink("pump-set", { lang: t.lang, embed: "1", autostart: "1" });
---

<HeroStage t={t} primaryHref="#demos" demoLinks={demoLinks} tabletApp={tabletApp} />
