---
/**
 * The three product lines: Showcase (the 3D explainer, available), Configurator (new, with live
 * examples) and Support (in discovery, a conversation not a product). Website, sales and
 * exhibition are use cases of Showcase, not product lines. Each card names the value it gives
 * (explore / configure / understand) and links to its detail page or demo. `home` is the home
 * page path, so other pages can link back to its sections.
 */
import Icon from "./Icon.astro";
import Tip from "./Tip.astro";
import { demoLink } from "@/studio/config";
import type { Copy } from "@/studio/i18n/en";
import { withBase } from "@/lib/paths";

interface Props {
  t: Copy;
  home?: string;
}

const { t, home = "" } = Astro.props;
const p = t.platform;
const m = p.modules;
const lang = t.lang;
const contact = `${home}#contact`;
// Contact form "What do you want to explain?" options (contact.fields.needOptions).
const NEED_CONFIGURATOR = 3;
const NEED_SERVICE = 4;
// The Showcase page is English only, like the other product pages.
const showcasePage = lang === "en" ? withBase("/showcase/") : `${home}#pricing`;

const cards = [
  {
    id: "showcase",
    icon: "cube",
    status: "available",
    verbs: ["explore", "understand"],
    c: m.showcase,
    primary: { href: demoLink(undefined, { lang }), label: m.showcase.cta, external: true },
    secondary: { href: showcasePage, label: m.showcase.more },
  },
  {
    id: "configurator",
    icon: "sliders",
    status: "new",
    verbs: ["configure"],
    c: m.configurator,
    primary: { href: demoLink("iso-cylinder", { view: "configure", lang }), label: m.configurator.cta, external: true },
    secondary: { href: contact, label: m.configurator.more, need: NEED_CONFIGURATOR },
  },
  {
    id: "service",
    icon: "gear",
    status: "future",
    verbs: [],
    c: m.service,
    primary: { href: contact, label: m.service.cta, need: NEED_SERVICE },
  },
] as const;
---

<section class="section section--paper" id="solutions">
  <div class="wrap">
    <h2 class="section__title">
      {p.title}
      <Tip text={p.lead} />
    </h2>
    <div class="modules">
      {cards.map((card) => (
        <article class:list={["module", `module--${card.status}`]} id={`product-${card.id}`}>
          <div class="module__top">
            <Icon name={card.icon} />
            <span class="module__status">{p.status[card.status]}</span>
          </div>
          <h3>
            {card.c.name}
            <Tip text={card.status === "future" ? `${card.c.text} ${card.c.points.join(". ")}.` : `${card.c.text} ${card.c.note}`} />
          </h3>
          <p class="module__kind">{card.c.kind}</p>
          {card.verbs.length > 0 && (
            <p class="verbs">
              {card.verbs.map((verb) => <span class={`verb verb--${verb}`}>{p.verbs[verb]}</span>)}
            </p>
          )}
          {/* "In discovery" says it all; that card's points live in its tip. */}
          {card.status !== "future" && (
            <ul class="module__points">
              {card.c.points.map((point) => <li>{point}</li>)}
            </ul>
          )}
          <div class="module__actions">
            {card.primary.href && (
              <a
                class:list={["btn", card.status === "future" ? "btn--ghost" : "btn--orange"]}
                href={card.primary.href}
                data-need={"need" in card.primary ? card.primary.need : undefined}
                {...("external" in card.primary ? { target: "_blank", rel: "noreferrer" } : {})}
              >
                {card.primary.label}
                {"external" in card.primary && <span aria-hidden="true"> ↗</span>}
              </a>
            )}
            {"secondary" in card && (
              <a class="link-arrow" href={card.secondary.href} data-need={"need" in card.secondary ? card.secondary.need : undefined}>
                {card.secondary.label} →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".module [data-need]").forEach((link) =>
    link.addEventListener("click", () => {
      const select = document.querySelector<HTMLSelectElement>("[data-enquiry] select[name=need]");
      if (select) select.selectedIndex = Number(link.dataset.need);
    }),
  );
</script>
