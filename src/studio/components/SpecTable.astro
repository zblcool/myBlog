---
/**
 * Brochure-style spec table: navy header row, zebra rows. With `group`, consecutive rows with
 * the same first cell share it (rowspan), e.g. one part with several properties.
 */
interface Props {
  caption: string;
  head: string[];
  rows: string[][];
  group?: boolean;
}

const { caption, head, rows, group = false } = Astro.props;

const spans = rows.map((row, i) => {
  if (!group) return 1;
  if (i > 0 && rows[i - 1][0] === row[0]) return 0;
  let n = 1;
  while (i + n < rows.length && rows[i + n][0] === row[0]) n++;
  return n;
});
---

<div class:list={["spec-table", group && "spec-table--grouped"]}>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>{head.map((h) => <th scope="col">{h}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row, i) => (
        <tr class:list={[group && spans[i] > 0 && i > 0 && "spec-table__group"]}>
          {row.map((cell, c) =>
            c === 0 && group ? (
              spans[i] > 0 && <th scope="row" rowspan={spans[i]}>{cell}</th>
            ) : c === 0 ? (
              <th scope="row">{cell}</th>
            ) : (
              <td>{cell}</td>
            ),
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
