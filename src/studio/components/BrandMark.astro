---
/**
 * The "A" mark (geometry in data/brandMark.ts). `onDark` swaps the dark parts for silver.
 */
import { markColors, markGradients, markPaths, markViewBox as box, type MarkVariant } from "@/studio/data/brandMark";

interface Props {
  size?: number;
  variant?: MarkVariant;
  class?: string;
}

const { size = 32, variant = "onDark", class: className } = Astro.props;
const colors = markColors[variant];

// Unique per instance: a gradient referenced across a hidden <svg> stops rendering in Chrome.
const id = `mark-${variant}-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class={className}
  viewBox={`${box.x} ${box.y} ${box.width} ${box.height}`}
  width={Math.round((size * box.width) / box.height)}
  height={size}
  aria-hidden="true"
>
  <defs>
    {markPaths.map(({ part }) => (
      <linearGradient id={`${id}-${part}`} x1={markGradients[part].x1} y1="0" x2={markGradients[part].x2} y2={markGradients[part].y2}>
        <stop offset="0" stop-color={colors[part][0]} />
        <stop offset="1" stop-color={colors[part][1]} />
      </linearGradient>
    ))}
  </defs>
  <g stroke-linejoin="round" stroke-width="6">
    {markPaths.map(({ part, d }) => <path d={d} fill={`url(#${id}-${part})`} stroke={`url(#${id}-${part})`} />)}
  </g>
</svg>
