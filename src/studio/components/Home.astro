---
import Contact from "./Contact.astro";
import Hero from "./Hero.astro";
import Icon from "./Icon.astro";
import Showcase from "./Showcase.astro";
import { demoLink, socialLinks } from "@/studio/config";
import { shot } from "@/studio/data/devices";
import type { Copy } from "@/studio/i18n/en";
import { withBase } from "@/lib/paths";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
const linkedin = socialLinks.find((l) => l.label === "LinkedIn")!.href;
const kioskLink = demoLink(undefined, { mode: "kiosk", lang: t.lang });
const modes = [
  { device: "disk-brake", view: "xray" },
  { device: "hope-rotor", view: "exploded" },
  { device: "worm-gearbox", view: "section" },
] as const;
---

<Hero t={t} />

<section class="section section--paper" id="problem">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{t.problem.label}</p>
      <h2>{t.problem.title}</h2>
    </div>
    <ol class="problems">
      {t.problem.items.map((item, i) => (
        <li>
          <span class="problems__num">0{i + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section" id="product">
  <div class="wrap">
    <div class="section__head section__head--split">
      <div>
        <p class="eyebrow">{t.product.label}</p>
        <h2>{t.product.title}</h2>
      </div>
      <p class="section__lead">{t.product.lead}</p>
    </div>
    <div class="features">
      {t.product.features.map((feature) => (
        <article class="feature">
          <Icon name={feature.icon} />
          <h3>{feature.title}</h3>
          <p>{feature.text}</p>
        </article>
      ))}
    </div>
    <div class="modes">
      {modes.map(({ device, view }) => (
        <figure>
          <div class="modes__img">
            <img src={withBase(shot(device, view))} alt={`${t.showcase.devices[device].name}: ${t.hero.views[view]}`} width="1600" height="1000" loading="lazy" />
          </div>
          <figcaption>{t.hero.views[view]} · {t.showcase.devices[device].name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<Showcase t={t} />

<section class="section" id="shows">
  <div class="wrap split">
    <div>
      <p class="eyebrow">{t.shows.label}</p>
      <h2>{t.shows.title}</h2>
      <p class="section__lead">{t.shows.lead}</p>
      <ul class="checklist">
        {t.shows.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
      {kioskLink && (
        <a class="link-arrow" href={kioskLink} target="_blank" rel="noreferrer">{t.shows.kiosk} ↗</a>
      )}
    </div>
    <div class="kiosk" aria-hidden="true">
      <div class="kiosk__screen">
        <img src={withBase(shot("jet-engine", "scan"))} alt="" width="1600" height="1000" loading="lazy" />
        <span class="kiosk__badge"><span class="app__dot"></span>{t.shows.kiosk}</span>
        <div class="kiosk__caption">
          <span>02 / 05</span>
          {t.showcase.devices["jet-engine"].tagline}
        </div>
        <div class="kiosk__qr">
          <span class="qr"></span>
          <span>
            <strong>{t.shows.qrTitle}</strong>
            {t.shows.qrText}
          </span>
        </div>
      </div>
      <div class="kiosk__stand"></div>
    </div>
  </div>
</section>

<section class="section section--navy-2" id="leads">
  <div class="wrap split split--reverse">
    <div>
      <p class="eyebrow">{t.leads.label}</p>
      <h2>{t.leads.title}</h2>
      <p class="section__lead">{t.leads.lead}</p>
      <ul class="ticks">
        {t.leads.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>
    <div class="enquiry-card" aria-label={t.leads.card.header}>
      <div class="enquiry-card__head">
        <span class="enquiry-card__dot"></span>
        <span>{t.leads.card.header}</span>
        <strong>{t.leads.card.product}</strong>
      </div>
      <dl>
        {t.leads.card.rows.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <span class="enquiry-card__link">{t.leads.card.link}</span>
    </div>
  </div>
</section>

<section class="services" aria-label={t.services.label}>
  <div class="wrap services__grid">
    {t.services.items.map((item) => (
      <div class="service">
        <Icon name={item.icon} size={40} />
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </div>
    ))}
  </div>
</section>

<section class="section" id="process">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{t.process.label}</p>
      <h2>{t.process.title}</h2>
    </div>
    <ol class="steps">
      {t.process.steps.map((step, i) => (
        <li>
          <span class="steps__num">{i + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section section--paper" id="faq">
  <div class="wrap split split--faq">
    <div>
      <p class="eyebrow">{t.faq.label}</p>
      <h2>{t.faq.title}</h2>
    </div>
    <div class="faq">
      {t.faq.items.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section about" id="about">
  <div class="wrap about__inner">
    <p class="eyebrow">{t.about.label}</p>
    <h2>{t.about.title}</h2>
    <p class="about__text">{t.about.text}</p>
    <div class="actions">
      <a class="link-arrow" href={linkedin} target="_blank" rel="noreferrer">{t.about.linkedin}</a>
    </div>
  </div>
</section>

<Contact t={t} />
