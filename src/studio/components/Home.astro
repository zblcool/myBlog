---
/**
 * The business home page. Rule: show, don't explain. Each section is a heading plus something
 * to look at or use; any explanation that has to exist sits in a Tip, off the main view.
 *
 * Order follows a first-time visitor: what this is (Hero) → what you can buy (Solutions: the
 * three product lines) → try it (Live Demos) → a full worked example (case study) → where it
 * runs (Use Cases) → how a project runs and why it's worth it (How it works, evidence) →
 * price, questions, contact. Feature detail (views, walkthroughs, enquiry context) lives on the
 * Showcase page and the product pages.
 */
import CaseTeaser from "./CaseTeaser.astro";
import Contact from "./Contact.astro";
import Hero from "./Hero.astro";
import LiveDemos from "./LiveDemos.astro";
import Modules from "./Modules.astro";
import Pricing from "./Pricing.astro";
import Scenarios from "./Scenarios.astro";
import Tip from "./Tip.astro";
import type { Copy } from "@/studio/i18n/en";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
---

<Hero t={t} />

<Modules t={t} />

<LiveDemos t={t} />

<CaseTeaser t={t} />

<Scenarios t={t} />

<section class="section section--navy-2" id="evidence">
  <div class="wrap">
    <h2 class="section__title">
      {t.evidence.title}
      <Tip text={t.evidence.note} />
    </h2>
    <ul class="stats">
      {t.evidence.items.map((item) => (
        <li>
          <strong class="stats__value">{item.value}</strong>
          <h3>
            {item.title}
            <Tip text={item.text} links={[{ href: item.href, label: item.source }]} />
          </h3>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section--paper" id="process">
  <div class="wrap">
    <h2 class="section__title">{t.process.title}</h2>
    <ol class="steps">
      {t.process.steps.map((step, i) => (
        <li>
          <span class="steps__num">{i + 1}</span>
          <h3>
            {step.title}
            <Tip text={step.text} />
          </h3>
        </li>
      ))}
    </ol>
  </div>
</section>

<Pricing t={t} />

<section class="section section--paper" id="faq">
  <div class="wrap split split--faq">
    <h2 class="section__title">{t.faq.title}</h2>
    <div class="faq">
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<Contact t={t} />
