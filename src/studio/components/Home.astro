---
/**
 * The business home page. Rule: show, don't explain. Each section is a heading plus something
 * to look at or use; any explanation that has to exist sits in a Tip, off the main view.
 */
import Contact from "./Contact.astro";
import Hero from "./Hero.astro";
import Modules from "./Modules.astro";
import Pricing from "./Pricing.astro";
import Scenarios from "./Scenarios.astro";
import Tip from "./Tip.astro";
import { products } from "@/studio/data/products";
import type { Copy } from "@/studio/i18n/en";
import { withBase } from "@/lib/paths";

interface Props {
  t: Copy;
}

const { t } = Astro.props;
// Product pages are English only, like the other landing pages.
const productPages = t.lang === "en";
---

<Hero t={t} />

<section class="section section--navy" id="evidence">
  <div class="wrap">
    <h2 class="section__title">
      {t.evidence.title}
      <Tip text={t.evidence.note} />
    </h2>
    <ul class="stats">
      {t.evidence.items.map((item) => (
        <li>
          <strong class="stats__value">{item.value}</strong>
          <h3>
            {item.title}
            <Tip text={item.text} links={[{ href: item.href, label: item.source }]} />
          </h3>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section--paper" id="showcase">
  <div class="wrap">
    <h2 class="section__title">{t.showcase.title}</h2>
    <div class="machines">
      {products.map((p) => {
        const card = (
          <>
            <img src={withBase(p.diagram.image)} alt="" width={p.diagram.width} height={p.diagram.height} loading="lazy" />
            <strong>{t.showcase.devices[p.id].name}</strong>
          </>
        );
        return productPages ? (
          <a class="machine" href={withBase(`/showcase/${p.id}/`)}>{card}</a>
        ) : (
          <div class="machine">{card}</div>
        );
      })}
    </div>
  </div>
</section>

<Scenarios t={t} />

<Modules t={t} />

<section class="section section--navy-2" id="leads">
  <div class="wrap split split--reverse">
    <h2 class="section__title">
      {t.leads.title}
      <Tip text={t.leads.lead} />
    </h2>
    <div class="enquiry-card" aria-label={t.leads.card.header}>
      <div class="enquiry-card__head">
        <span class="enquiry-card__dot"></span>
        <span>{t.leads.card.header}</span>
        <strong>{t.leads.card.product}</strong>
      </div>
      <dl>
        {t.leads.card.rows.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <span class="enquiry-card__link">{t.leads.card.link}</span>
    </div>
  </div>
</section>

<section class="section" id="process">
  <div class="wrap">
    <h2 class="section__title">{t.process.title}</h2>
    <ol class="steps">
      {t.process.steps.map((step, i) => (
        <li>
          <span class="steps__num">{i + 1}</span>
          <h3>
            {step.title}
            <Tip text={step.text} />
          </h3>
        </li>
      ))}
    </ol>
  </div>
</section>

<Pricing t={t} />

<section class="section section--paper" id="faq">
  <div class="wrap split split--faq">
    <h2 class="section__title">{t.faq.title}</h2>
    <div class="faq">
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<Contact t={t} />
