---
import "@fontsource/montserrat/latin-400.css";
import "@fontsource/montserrat/latin-500.css";
import "@fontsource/montserrat/latin-600.css";
import "@fontsource/montserrat/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@/studio/styles/studio.css";
import Lockup from "@/studio/components/Lockup.astro";
import MegaMenu from "@/studio/components/MegaMenu.astro";
import { menus } from "@/studio/data/nav";
import { analytics, brand, contactEmail, socialLinks } from "@/studio/config";
import { devices } from "@/studio/data/devices";
import { solutions } from "@/studio/data/solutions";
import { copies, localePath, type Lang } from "@/studio/i18n";
import { withBase } from "@/lib/paths";

interface Props {
  lang: Lang;
  /** Path of this page without the language prefix, for the canonical link. */
  path?: string;
  title?: string;
  description?: string;
  /** schema.org JSON-LD for this page. */
  structuredData?: object;
}

const { lang, path = "/", title, description, structuredData } = Astro.props;
const t = copies[lang];
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const home = localePath(lang, "/");
const year = new Date().getFullYear();

// English: Products and Solutions are dropdowns (their pages are English only); the hidden
// Chinese copy keeps plain links to its own sections.
const dropdowns = lang === "en" ? menus : [];
const nav = [
  ...(lang === "en" ? [] : [{ href: `${home}#solutions`, label: t.nav.products }]),
  { href: `${home}#demos`, label: t.nav.demos },
  { href: `${home}#pricing`, label: t.nav.pricing },
  { href: `${home}#faq`, label: t.nav.faq },
];

const absolute = (p: string) => (Astro.site ? new URL(p, Astro.site).toString() : p);
const pageUrl = absolute(localePath(lang, path));
const ogImage = absolute(withBase("/studio/og-image.jpg"));
// "</" inside JSON would close the script element early.
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content={brand.palette.navy} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_AU"} />
    {/* Non-English pages are reachable by URL only: not linked, not in the sitemap, not indexed. */}
    {lang !== "en" && <meta name="robots" content="noindex" />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" type="image/svg+xml" href={withBase("/studio/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/studio/apple-touch-icon.png")} />
    {analytics.domain && <script is:inline defer data-domain={analytics.domain} src={`${analytics.host}/js/script.js`} />}
  </head>
  <body data-lang={lang}>
    <a class="skip" href="#main">{lang === "zh" ? "跳到正文" : "Skip to content"}</a>
    <header class="header" data-header>
      <div class="wrap header__inner">
        <a class="header__brand" href={home} aria-label={brand.name}>
          <Lockup size={26} />
        </a>
        <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
          <span class="header__burger" aria-hidden="true"></span>
          <span class="sr-only">{t.nav.menu}</span>
        </button>
        <nav class="header__nav" id="site-nav" aria-label="Primary">
          {dropdowns.map((menu) => <MegaMenu menu={menu} openLabel={t.nav.menus.open} />)}
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="btn btn--orange btn--sm" href={`${home}#contact`}>{t.nav.cta}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <Lockup size={34} tagline={t.tagline} />
        </div>
        <div class="footer__links">
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          {socialLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
          <a href={localePath(lang, "/privacy/")}>{t.footer.privacy}</a>
          <a href={withBase("/blog/")}>{t.footer.blog}</a>
        </div>
        {lang === "en" && (
          <div class="footer__links">
            {solutions.map((s) => <a href={withBase(`/${s.slug}/`)}>{s.name}</a>)}
          </div>
        )}
      </div>
      <div class="wrap footer__meta">
        <p>© {year} {brand.name}. {t.footer.rights}</p>
        <p class="footer__credits">
          {t.footer.credits}: {devices.map((d) => d.credit).join(" · ")}
        </p>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>("[data-header]")!;
      const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
      const setOpen = (open: boolean) => {
        header.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", String(open));
      };
      toggle.addEventListener("click", () => setOpen(!header.classList.contains("is-open")));
      header.querySelectorAll(".header__nav a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // --- dropdowns (MegaMenu) ----------------------------------------------------
      // Desktop: hover opens (with a short grace period on the way out), a click toggles, Escape,
      // a click outside or focus leaving closes. Under the burger they are fold-out lists.
      const burger = matchMedia("(max-width: 1040px)");
      const hover = matchMedia("(hover: hover) and (pointer: fine)");
      const menus = [...header.querySelectorAll<HTMLElement>("[data-menu]")];
      let closeTimer = 0;
      const openMenu = (menu: HTMLElement | null) => {
        clearTimeout(closeTimer);
        for (const m of menus) {
          const on = m === menu;
          m.classList.toggle("is-open", on);
          m.querySelector("[data-menu-trigger]")!.setAttribute("aria-expanded", String(on));
        }
        header.classList.toggle("is-menu", Boolean(menu) && !burger.matches);
      };
      const showCard = (menu: HTMLElement, link: HTMLAnchorElement) => {
        const card = menu.querySelector<HTMLAnchorElement>("[data-menu-card]");
        if (!card) return;
        const d = link.dataset;
        const img = card.querySelector<HTMLImageElement>("[data-card-img]")!;
        img.hidden = !d.cardImage;
        if (d.cardImage) img.src = d.cardImage;
        card.querySelectorAll<HTMLElement>("[data-card-iconbox]").forEach((box) => (box.hidden = Boolean(d.cardImage) || box.dataset.cardIconbox !== d.cardIcon));
        card.querySelector("[data-card-eyebrow]")!.textContent = d.cardEyebrow ?? "";
        card.querySelector("[data-card-title]")!.textContent = d.cardTitle ?? "";
        card.querySelector("[data-card-text]")!.textContent = d.cardText ?? "";
        card.href = link.href;
        card.target = link.target;
        card.rel = link.rel;
        menu.querySelectorAll("a[data-card-title]").forEach((a) => a.classList.toggle("is-current", a === link));
      };
      for (const menu of menus) {
        const trigger = menu.querySelector<HTMLButtonElement>("[data-menu-trigger]")!;
        trigger.addEventListener("click", () => openMenu(menu.classList.contains("is-open") ? null : menu));
        menu.addEventListener("pointerenter", () => {
          if (hover.matches && !burger.matches) openMenu(menu);
        });
        menu.addEventListener("pointerleave", () => {
          if (!hover.matches || burger.matches) return;
          clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => menu.classList.contains("is-open") && openMenu(null), 220);
        });
        menu.querySelectorAll<HTMLAnchorElement>("a[data-card-title]").forEach((link) => {
          const show = () => showCard(menu, link);
          link.addEventListener("pointerenter", show);
          link.addEventListener("focus", show);
          link.addEventListener("click", () => openMenu(null));
        });
        menu.addEventListener("focusout", (event) => {
          if (!menu.contains(event.relatedTarget as Node | null) && !burger.matches) openMenu(null);
        });
      }
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const open = menus.find((m) => m.classList.contains("is-open"));
        if (!open) return;
        openMenu(null);
        open.querySelector<HTMLButtonElement>("[data-menu-trigger]")!.focus();
      });
      document.addEventListener("pointerdown", (event) => {
        if (!burger.matches && !menus.some((m) => m.contains(event.target as Node))) openMenu(null);
      });
      burger.addEventListener("change", () => openMenu(null));
    </script>
  </body>
</html>
