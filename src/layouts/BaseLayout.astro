---
import "@/styles/global.css";
import { contactHref, contactLabel, navLinks, profile, socialLinks } from "@/data/site";
import { stripBase, withBase } from "@/lib/paths";

interface Props {
  title?: string;
  description?: string;
  cta?: boolean;
}

const {
  title = `${profile.name} | ${profile.title}`,
  description = profile.description,
  cta = true,
} = Astro.props;

const pathname = stripBase(Astro.url.pathname);
const isActive = (link: { href: string; match?: string[] }) =>
  !link.href.includes("#") && (link.match ?? [link.href]).some((path) => pathname.startsWith(path));
const external = contactHref.startsWith("http");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href={withBase("/logo.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={withBase("/blog/")}>
          <img src={withBase("/logo.png")} alt="" />
          <span>{profile.name}</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="nav-toggle__label">Menu</span>
        </button>
        <nav class="nav" id="site-nav" aria-label="Primary">
          {navLinks.map((link) => (
            <a href={withBase(link.href)} data-active={isActive(link)}>
              {link.label}
            </a>
          ))}
          <a
            class="btn btn--sm"
            href={contactHref}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer" : undefined}>{contactLabel}</a
          >
        </nav>
      </div>
    </header>

    <main class="page">
      <slot />
    </main>

    {cta && (
      <section class="cta">
        <div class="wrap">
          <h2>Have a project in <em>mind?</em></h2>
          <div class="hero__actions">
            <a
              class="btn btn--solid"
              href={contactHref}
              target={external ? "_blank" : undefined}
              rel={external ? "noreferrer" : undefined}>{contactLabel} →</a
            >
            <a class="btn" href={withBase("/document/Ash-Zhang-CV.pdf")}>Download CV</a>
          </div>
        </div>
      </section>
    )}

    <script>
      const header = document.getElementById("site-header");
      const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
      const setOpen = (open: boolean) => {
        header?.toggleAttribute("data-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
        const label = toggle?.querySelector(".nav-toggle__label");
        if (label) label.textContent = open ? "Close" : "Menu";
      };
      toggle?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
      header?.querySelectorAll(".nav a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
    </script>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <div class="site-footer__links">
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
          ))}
        </div>
      </div>
    </footer>
  </body>
</html>
