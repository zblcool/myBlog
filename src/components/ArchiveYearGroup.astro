---
import ContentCard from "@/components/ContentCard.astro";
import type { ArchiveYearGroup, WritingKind } from "@/lib/content";

interface Props {
  group: ArchiveYearGroup;
  kind: WritingKind;
}

const { group, kind } = Astro.props;
---

<section class="archive-group">
  <div class="section-head archive-group__head">
    <div>
      <h2>{group.year}</h2>
      <p>{group.entries.length} entries</p>
    </div>
  </div>

  <div class="card-grid">
    {group.entries.map((entry) => <ContentCard entry={entry} kind={kind} />)}
  </div>
</section>
