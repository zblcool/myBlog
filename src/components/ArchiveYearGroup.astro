---
import ContentCard from "@/components/ContentCard.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import type { ArchiveYearGroup, WritingKind } from "@/lib/content";

interface Props {
  group: ArchiveYearGroup;
  kind: WritingKind;
}

const { group, kind } = Astro.props;
---

<section class="archive-group">
  <SectionHeader
    title={group.year}
    description={`${group.entries.length} entries`}
    className="archive-group__head"
  />

  <div class="card-grid">
    {group.entries.map((entry) => <ContentCard entry={entry} kind={kind} />)}
  </div>
</section>
