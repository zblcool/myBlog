---
import type { WritingEntry, WritingKind } from "@/lib/content";
import { formatDate, getEntryUrl } from "@/lib/content";
import { withBase } from "@/lib/paths";

interface Props {
  entry: WritingEntry;
  kind: WritingKind;
}

const { entry, kind } = Astro.props;
---

<a class="entry-row" href={withBase(getEntryUrl(kind, entry))}>
  <span class="label">{formatDate(entry.data.date)}</span>
  <h3>{entry.data.title}</h3>
  <span class="tag-list">
    {entry.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
  </span>
</a>
